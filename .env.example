# Map tiles (required for map)
VITE_MAPTILER_KEY=your_maptiler_key_here

# Splitwise group link (shown in budget section)
VITE_SPLITWISE_GROUP_URL=https://splitwise.com/groups/your-group-id

# Firebase Realtime Database (required for live crew location sharing)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Splitwise API (server-only — set in Vercel dashboard, not prefixed with VITE_)
# SPLITWISE_ACCESS_TOKEN=your_oauth_access_token
# SPLITWISE_GROUP_ID=12345678
