# Map tiles (required for map)
VITE_MAPTILER_KEY=your_maptiler_key_here

# Splitwise group link (optional — adds an "Open group" link in the budget section)
VITE_SPLITWISE_GROUP_URL=https://secure.splitwise.com/#/groups/your-group-id

# Firebase Realtime Database (required for live crew location sharing)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Splitwise API — powers the live in-app balance tracker.
# Set BOTH in the Vercel dashboard (server-only, NOT prefixed with VITE_).
# Get the token from secure.splitwise.com/apps → your app → "Create API key".
# SPLITWISE_ACCESS_TOKEN=your_personal_api_key
# SPLITWISE_GROUP_ID=99558556
